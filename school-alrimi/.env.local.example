# NEIS Open API (data.go.kr) — server-side only
# Get a key from https://www.data.go.kr/data/15139198/openapi.do
NEIS_API_KEY=your_neis_api_key_here

# Supabase project — get these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role — NEVER expose to the browser. Used for admin/scripts.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
# Public key is safe to expose (used in the browser); private key stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
