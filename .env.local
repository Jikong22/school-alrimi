# School-Alrimi — local environment template
# Copy to .env (gitignored) and fill in real values from
#   Supabase Dashboard -> Project Settings -> API
# Once you have a project. Do NOT commit real keys.

# --- Supabase ---
# Project URL (e.g. https://abcdefghijk.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon (public) key — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...REPLACE_ME...

# service_role key — SERVER ONLY, never expose to the browser.
# Used for: seeding, admin tasks, RLS-test-03. Treat like a DB password.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...REPLACE_ME...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
